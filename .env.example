# Server-side Spring Boot API base URL (never expose production credentials in local development).
API_BASE_URL=http://localhost:8080
APP_ORIGIN=http://localhost:3000

# Shared secret for authenticated BFF-to-API client-IP forwarding; match the API value.
KULHA_BFF_SHARED_SECRET=

# Google OAuth Web client. The redirect URI must be registered exactly in Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Defaults to APP_ORIGIN + /api/auth/google/callback when omitted.
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
