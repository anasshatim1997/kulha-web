{
  "name": "kulha-morocco-web",
  "version": "1.1.0",
  "private": true,
  "description": "KULHA! Moroccan surplus-food basket marketplace web app",
  "scripts": {
    "dev": "node scripts/clean-next-cache.mjs && next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
